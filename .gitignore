*.db-shm
*.db.bak*

# Secretos generados en runtime — NUNCA en git
master.key
jwt.secret
secrets/
INITIAL_PIN.txt
cert.pem
key.pem

# Build artifacts del .exe
.tmp-exe-build/
server-launcher.cjs
.claude/

# Instaladores compilados (se publican en GitHub Releases, no en git)
dist-installer/

# Cache del scanner de seguridad (secscan)
.secscan/

# Marcador para forzar HTTP en preview (nunca debe existir)
.no-tls-preview
